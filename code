"""
  MQTT Smart Room Monitoring
  Studi Kasus: Opsi A – Smart Room Monitoring
  Semua skenario dalam satu file

  Skenario 1 : Komunikasi Dasar Publisher–Subscriber
  Skenario 2 : Pengiriman Data dengan QoS 0, 1, 2
  Skenario 3 : Penggunaan Beberapa Topik
  Skenario 4 : Penggunaan Wildcard +
  Skenario 5 : Penggunaan Wildcard #

"""

import paho.mqtt.client as mqtt
import json
import random
import time

BROKER = "localhost"
PORT   = 1883

QOS_DESC = {
    0: "At most once  (fire and forget – tanpa konfirmasi)",
    1: "At least once (dengan ACK – bisa duplikat)",
    2: "Exactly once  (dijamin tepat satu kali)",
}

def buat_client(client_id: str) -> mqtt.Client:
    """Membuat dan mengembalikan MQTT client baru."""
    c = mqtt.Client(
        mqtt.CallbackAPIVersion.VERSION2,
        client_id=client_id
    )
    return c


def koneksi(client: mqtt.Client):
    """Menghubungkan client ke broker dan menunggu koneksi established."""
    def on_connect(cl, userdata, flags, rc, props):
        print(f"  [CONNECTED] Broker: {BROKER}:{PORT} | Code: {rc}")
    client.on_connect = on_connect
    client.connect(BROKER, PORT)
    client.loop_start()
    time.sleep(1)   


def cetak_header(judul: str):
    print("\n")
    print(f"  {judul}")
    print("\n")


#Skenario 1

def scenario1_publisher():
    cetak_header("SKENARIO 1 – PUBLISHER (Komunikasi Dasar)")
    TOPIC = "smartroom/sensor/temperature"

    client = buat_client("SmartRoom_S1_Pub")
    koneksi(client)

    payload = {
        "device"    : "temperature_sensor",
        "room"      : "living_room",
        "value"     : 28,
        "unit"      : "C",
        "timestamp" : time.strftime("%Y-%m-%d %H:%M:%S"),
    }

    result = client.publish(TOPIC, json.dumps(payload), qos=0)
    result.wait_for_publish()

    print(f"\n  [SENT] Topic  : {TOPIC}")
    print(f"         Payload: {json.dumps(payload, indent=4)}")

    time.sleep(1)
    client.loop_stop()
    client.disconnect()
    print("\n  DISCONNECTED")


def scenario1_subscriber():
    cetak_header("SKENARIO 1 – SUBSCRIBER (Komunikasi Dasar)")
    TOPIC = "smartroom/sensor/temperature"

    def on_connect(cl, userdata, flags, rc, props):
        print(f"  CONNECTED Broker: {BROKER}:{PORT}")
        cl.subscribe(TOPIC)
        print(f"  SUBSCRIBED {TOPIC}")
        print("\n  Menunggu pesan (Ctrl+C = stop)\n")

    def on_message(cl, userdata, msg):
        print("  " + "-" * 45)
        print(f"  TOPIC  : {msg.topic}")
        print(f"  QoS    : {msg.qos}")
        try:
            data = json.loads(msg.payload.decode())
            for k, v in data.items():
                print(f"  {k:10}: {v}")
        except Exception:
            print(f"  DATA   : {msg.payload.decode()}")
        print("  " + "-" * 45)

    client = buat_client("SmartRoom_S1_Sub")
    client.on_connect = on_connect
    client.on_message = on_message
    client.connect(BROKER, PORT)
    client.loop_forever()


# SKENARIO 2 QoS BERBEDA

def scenario2_publisher():
    cetak_header("SKENARIO 2 – PUBLISHER (QoS 0 / 1 / 2)")
    TOPIC = "smartroom/sensor/temperature"

    def on_publish(cl, userdata, mid, rc, props):
        print(f"    ✓ ACK diterima – Message ID: {mid}")

    client = buat_client("SmartRoom_S2_Pub")
    client.on_publish = on_publish
    koneksi(client)

    for qos in [0, 1, 2]:
        payload = {
            "device"    : "temperature_sensor",
            "room"      : "bedroom",
            "value"     : 25 + qos,
            "unit"      : "C",
            "qos_level" : qos,
            "timestamp" : time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        print(f"\n  [QoS {qos}] {QOS_DESC[qos]}")
        print(f"    Mengirim : {json.dumps(payload)}")

        result = client.publish(TOPIC, json.dumps(payload), qos=qos)
        if qos > 0:
            result.wait_for_publish()

        print(f"    Status   : {'BERHASIL' if result.rc == 0 else 'GAGAL'}")
        time.sleep(2)

    client.loop_stop()
    client.disconnect()
    print("\n  [DISCONNECTED]")


def scenario2_subscriber():
    cetak_header("SKENARIO 2 – SUBSCRIBER (QoS 0 / 1 / 2)")
    TOPIC = "smartroom/sensor/temperature"
    counter = {0: 0, 1: 0, 2: 0}

    def on_connect(cl, userdata, flags, rc, props):
        print(f"  [CONNECTED] Broker: {BROKER}:{PORT}")
        cl.subscribe(TOPIC, qos=2)  
        print(f"  [SUBSCRIBED] {TOPIC}  (QoS 2 – mendukung semua level)")
        print("\n  Menunggu pesan... (Ctrl+C untuk berhenti)\n")

    def on_message(cl, userdata, msg):
        try:
            data = json.loads(msg.payload.decode())
        except Exception:
            data = {}
        q = msg.qos
        counter[q] = counter.get(q, 0) + 1

        print("  " + "-" * 50)
        print(f"  QoS Level : {q}  –  {QOS_DESC.get(q,'?')}")
        print(f"  Topic     : {msg.topic}")
        print(f"  Value     : {data.get('value','?')} {data.get('unit','')}")
        print(f"  Timestamp : {data.get('timestamp','-')}")
        print(f"  [Counter] QoS0={counter[0]} | QoS1={counter[1]} | QoS2={counter[2]}")
        print("  " + "-" * 50)

    client = buat_client("SmartRoom_S2_Sub")
    client.on_connect = on_connect
    client.on_message = on_message
    client.connect(BROKER, PORT)
    client.loop_forever()


#SKENARIO 3  MULTI TOPIK

def scenario3_publisher():
    cetak_header("SKENARIO 3 – PUBLISHER (Multi Topik)")

    TOPICS = {
        "temperature" : "smartroom/sensor/temperature",
        "humidity"    : "smartroom/sensor/humidity",
        "light"       : "smartroom/sensor/light",
        "lamp"        : "smartroom/actuator/lamp",
        "ac"          : "smartroom/actuator/ac",
    }

    client = buat_client("SmartRoom_S3_Pub")
    koneksi(client)

    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    data = {
        "temperature" : {"device":"DHT22_temp","room":"living_room","value":random.randint(22,35),"unit":"C","timestamp":ts},
        "humidity"    : {"device":"DHT22_hum", "room":"living_room","value":random.randint(40,90),"unit":"%RH","timestamp":ts},
        "light"       : {"device":"LDR",        "room":"living_room","value":random.randint(0,1000),"unit":"lux","timestamp":ts},
        "lamp"        : {"device":"relay_lamp", "room":"living_room","state":random.choice(["ON","OFF"]),"timestamp":ts},
        "ac"          : {"device":"relay_ac",   "room":"living_room","state":random.choice(["ON","OFF"]),"setpoint":24,"timestamp":ts},
    }

    print(f"\n  Mengirim ke {len(TOPICS)} topik...\n")
    for key, topic in TOPICS.items():
        payload = json.dumps(data[key])
        result  = client.publish(topic, payload, qos=1)
        result.wait_for_publish()
        print(f"  [OK] {topic}")
        print(f"       {payload}\n")
        time.sleep(0.3)

    print("  [DONE] Semua topik berhasil dikirim.")
    client.loop_stop()
    client.disconnect()


def scenario3_subscriber():
    cetak_header("SKENARIO 3 – SUBSCRIBER (Multi Topik)")

    TOPICS = [
        ("smartroom/sensor/temperature", 1),
        ("smartroom/sensor/humidity",    1),
        ("smartroom/sensor/light",       1),
        ("smartroom/actuator/lamp",      1),
        ("smartroom/actuator/ac",        1),
    ]
    ICON = {"sensor":" ", "actuator": " "}

    def on_connect(cl, userdata, flags, rc, props):
        print(f"  [CONNECTED] Broker: {BROKER}:{PORT}")
        cl.subscribe(TOPICS)
        print("  [SUBSCRIBED] Topik yang dipantau:")
        for t, q in TOPICS:
            print(f"    - {t}  (QoS {q})")
        print("\n  Menunggu pesan... (Ctrl+C untuk berhenti)\n")

    def on_message(cl, userdata, msg):
        parts    = msg.topic.split("/")
        cat      = parts[1] if len(parts) > 1 else "?"
        icon     = ICON.get(cat)
        try:
            data = json.loads(msg.payload.decode())
        except Exception:
            data = {"raw": msg.payload.decode()}
        print(f"  {icon} [{cat.upper()}]  {msg.topic}")
        for k, v in data.items():
            print(f"    {k:12}: {v}")
        print()

    client = buat_client("SmartRoom_S3_Sub")
    client.on_connect = on_connect
    client.on_message = on_message
    client.connect(BROKER, PORT)
    client.loop_forever()


#SKENARIO 4 WILDCARD +

def scenario4_publisher():
    cetak_header("SKENARIO 4 – PUBLISHER (Wildcard +)")
    print("  Struktur topik : smartroom/{room}/temperature")
    print("  Wildcard sub   : smartroom/+/temperature\n")

    ROOMS = {
        "living_room" : random.randint(26, 32),
        "bedroom"     : random.randint(22, 28),
        "kitchen"     : random.randint(28, 36),
        "bathroom"    : random.randint(24, 30),
    }

    client = buat_client("SmartRoom_S4_Pub")
    koneksi(client)

    for room, temp in ROOMS.items():
        topic = f"smartroom/{room}/temperature"
        payload = {
            "device"    : f"temp_sensor_{room}",
            "room"      : room,
            "value"     : temp,
            "unit"      : "C",
            "timestamp" : time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        result = client.publish(topic, json.dumps(payload), qos=1)
        result.wait_for_publish()
        print(f"  [OK] {topic}  →  {temp}°C")
        time.sleep(0.5)

    print("\n  [DONE] Data semua ruangan terkirim.")
    client.loop_stop()
    client.disconnect()


def scenario4_subscriber():
    cetak_header("SKENARIO 4 – SUBSCRIBER (Wildcard +)")
    WILDCARD = "smartroom/+/temperature"

    def on_connect(cl, userdata, flags, rc, props):
        print(f"  [CONNECTED] Broker: {BROKER}:{PORT}")
        cl.subscribe(WILDCARD, qos=1)
        print(f"  [SUBSCRIBED] {WILDCARD}")
        print("    -> '+' menggantikan tepat satu level (nama ruangan)")
        print("\n  Menunggu pesan... (Ctrl+C untuk berhenti)\n")

    def on_message(cl, userdata, msg):
        parts = msg.topic.split("/")
        room  = parts[1] if len(parts) >= 2 else "unknown"
        try:
            data = json.loads(msg.payload.decode())
        except Exception:
            data = {}
        print(f"  [ROOM: {room.upper()}]")
        print(f"    Topic  : {msg.topic}")
        print(f"    Value  : {data.get('value','?')} {data.get('unit','')}")
        print(f"    Time   : {data.get('timestamp','-')}")
        print()

    client = buat_client("SmartRoom_S4_Sub")
    client.on_connect = on_connect
    client.on_message = on_message
    client.connect(BROKER, PORT)
    client.loop_forever()


#SKENARIO 5 WILDCARD #

def scenario5_publisher():
    cetak_header("SKENARIO 5 – PUBLISHER (Wildcard #)")
    print("  Wildcard sub yang akan menangkap: smartroom/#\n")

    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    ALL_TOPICS = [
        ("smartroom/sensor/temperature", {"device":"DHT22_temp","value":random.randint(22,35),"unit":"C","timestamp":ts}),
        ("smartroom/sensor/humidity",    {"device":"DHT22_hum", "value":random.randint(40,90),"unit":"%RH","timestamp":ts}),
        ("smartroom/sensor/light",       {"device":"LDR",       "value":random.randint(0,1000),"unit":"lux","timestamp":ts}),
        ("smartroom/actuator/lamp",      {"device":"relay_lamp","state":random.choice(["ON","OFF"]),"timestamp":ts}),
        ("smartroom/actuator/ac",        {"device":"relay_ac",  "state":random.choice(["ON","OFF"]),"setpoint":24,"timestamp":ts}),
        ("smartroom/system/status",      {"broker":"online","uptime_sec":random.randint(100,9999),"timestamp":ts}),
        ("smartroom/system/alert",       {"level":"INFO","message":"System normal","timestamp":ts}),
    ]

    client = buat_client("SmartRoom_S5_Pub")
    koneksi(client)

    for topic, data_dict in ALL_TOPICS:
        result = client.publish(topic, json.dumps(data_dict), qos=1)
        result.wait_for_publish()
        print(f"  [OK] {topic}")
        print(f"       {json.dumps(data_dict)}\n")
        time.sleep(0.3)

    print("  [DONE] Semua topik dalam hierarki smartroom/ terkirim.")
    client.loop_stop()
    client.disconnect()


def scenario5_subscriber():
    cetak_header("SKENARIO 5 – SUBSCRIBER (Wildcard #)")
    WILDCARD = "smartroom/#"
    ICON = {"sensor":" ", "actuator":" ", "system":" "}
    stats = {"total": 0, "by_cat": {}}

    def on_connect(cl, userdata, flags, rc, props):
        print(f"  [CONNECTED] Broker: {BROKER}:{PORT}")
        cl.subscribe(WILDCARD, qos=1)
        print(f"  [SUBSCRIBED] {WILDCARD}")
        print("    → '#' menangkap SEMUA topik di bawah smartroom/")
        print("    → Termasuk: sensor/*, actuator/*, system/*")
        print("\n  Menunggu pesan... (Ctrl+C untuk berhenti)\n")

    def on_message(cl, userdata, msg):
        parts    = msg.topic.split("/")
        cat      = parts[1] if len(parts) > 1 else "?"
        subtype  = parts[2] if len(parts) > 2 else "?"
        icon     = ICON.get(cat, " ")
        stats["total"] += 1
        stats["by_cat"][cat] = stats["by_cat"].get(cat, 0) + 1
        try:
            data = json.loads(msg.payload.decode())
        except Exception:
            data = {"raw": msg.payload.decode()}

        print(f"  {icon} [{cat.upper()}/{subtype.upper()}]  {msg.topic}")
        for k, v in data.items():
            if k != "timestamp":
                print(f"    {k:12}: {v}")
        print(f"    timestamp   : {data.get('timestamp','-')}")
        stat_str = " | ".join(f"{k}={v}" for k, v in stats["by_cat"].items())
        print(f"    [Stats] Total={stats['total']} | {stat_str}")
        print()

    client = buat_client("SmartRoom_S5_Sub")
    client.on_connect = on_connect
    client.on_message = on_message
    client.connect(BROKER, PORT)
    client.loop_forever()


#MENU UTAMA

MENU_SKENARIO = {
    "1": ("Komunikasi Dasar",      scenario1_publisher, scenario1_subscriber),
    "2": ("QoS 0 / 1 / 2",        scenario2_publisher, scenario2_subscriber),
    "3": ("Multi Topik",           scenario3_publisher, scenario3_subscriber),
    "4": ("Wildcard +",            scenario4_publisher, scenario4_subscriber),
    "5": ("Wildcard #",            scenario5_publisher, scenario5_subscriber),
}

def tampil_menu():
    print("\nSMART ROOM MONITORING MQTT\n")
    for key, (nama, _, _) in MENU_SKENARIO.items():
        print(f"  {key}. Skenario {key} – {nama}")
    print("  0. Keluar")
    print("\n")
    print("  Struktur Topik:")
    print("    smartroom/sensor/temperature")
    print("    smartroom/sensor/humidity")
    print("    smartroom/sensor/light")
    print("    smartroom/actuator/lamp")
    print("    smartroom/actuator/ac")
    print("    smartroom/system/status")
    print("    smartroom/system/alert")
    print("\n")


if __name__ == "__main__":
    while True:
        tampil_menu()
        pilihan = input("  Pilih skenario [0-5] : ").strip()

        if pilihan == "0":
            print("\n  Keluar. Sampai jumpa!\n")
            break

        if pilihan not in MENU_SKENARIO:
            print("  [!] Pilihan tidak valid.")
            continue

        nama, fn_pub, fn_sub = MENU_SKENARIO[pilihan]

        print(f"\n  Mode untuk Skenario {pilihan} – {nama}")
        print("  [p] Publisher   [s] Subscriber")
        mode = input("  Pilih mode      : ").strip().lower()

        try:
            if mode == "p":
                fn_pub()
            elif mode == "s":
                fn_sub()
            else:
                print("  [!] Masukkan 'p' atau 's'.")
        except KeyboardInterrupt:
            print("\n\n  [STOP] Dihentikan oleh pengguna.")
        except Exception as e:
            print(f"\n  [ERROR] {e}")
            print("  Pastikan Mosquitto broker sudah berjalan di localhost:1883")
